# ============================================================================
# AFFICHES-EM — Variables d'environnement (copiez ce fichier en .env.local)
# ============================================================================

# Adresse du serveur PocketBase. Laissez vide : en ligne, l'application et
# PocketBase partagent le meme domaine ; en local, Vite relaie /api vers
# http://127.0.0.1:8090.
VITE_PB_URL=

# Connexion par nom d'utilisateur : « achraf » se connecte avec l'adresse
# technique achraf@affiches-em.local (jamais affichee).
VITE_DOMAINE_IDENTIFIANTS=affiches-em.local

# ----------------------------------------------------------------------------
# Copie des donnees depuis Appwrite (une seule fois : npm run migrer:pocketbase)
# Ces valeurs ne sont jamais incluses dans le site (pas de prefixe VITE_).
# ----------------------------------------------------------------------------
# APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
